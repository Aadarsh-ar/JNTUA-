{
  "name": "jntua-attendance",
  "main": "expo/AppEntry.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "eas:init": "eas init",
    "build:preview": "npx eas-cli build --profile preview --platform android",
    "build:production": "npx eas-cli build --profile production --platform android --non-interactive",
    "update:staging": "eas update --channel staging --message \"Staging update\"",
    "update:production": "eas update --channel production --message \"Production update\"",
    "promote:production": "eas promote --channel staging --to production",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
