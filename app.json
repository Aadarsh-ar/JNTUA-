{
  "expo": {
    "name": "JNTUA Attendance",
    "slug": "JNTUA-Attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-screen.png",
    "scheme": "jntuaattendance",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "INTERNET"
      ],
      "package": "com.steeveeswar.JNTUAAttendance"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-screen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-screen.png",
          "color": "#0F172A",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "updates": {
      "url": "https://u.expo.dev/4fd4af8e-878e-43bf-935d-0ef1d2b00b46",
      "checkAutomatically": "NEVER"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.steeveeswar.JNTUAAttendance"
    },
    "owner": "steeveeswar",
    "extra": {
      "eas": {
        "projectId": "4fd4af8e-878e-43bf-935d-0ef1d2b00b46"
      }
    }
  }
}
